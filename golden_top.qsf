set_global_assignment -name TOP_LEVEL_ENTITY golden_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.1.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:54:31  NOVEMBER 25, 2026"
